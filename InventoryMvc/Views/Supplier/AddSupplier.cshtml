@model InventoryMvc.ViewModels.AddSupplierViewModel
@{
    ViewData["Title"] = "Add Supplier";
}

<div style="width:60%">
    <h2>Add Supplier</h2>
    <a class="btn btn-info mb-2" href="/Supplier/Index">Show All</a>

     <form method="post">
         <div class="mb-2">
            <label class="form-label">SupplierName*</label>
            <input type="text" asp-for="SupplierName" class="form-control"/>
            <span asp-validation-for="SupplierName"></span>
         </div>

        <div class="mb-2">
            <label class="form-label">Contact Person</label>
            <input type="text" asp-for="ContactPerson" class="form-control" />
        </div>

        <div class="row mb-2">
            <div class="col">
                <label class="form-label">Email</label>
                <input type="email" asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="col">
                <label class="form-label">Phone</label>
                <input type="tel" asp-for="Phone" class="form-control" />
            </div>
        </div>

        <div class="mb-2">
            <label class="form-label">Address</label>
            <textarea asp-for="Address" class="form-control" rows="2"></textarea>
        </div>

        <div class="row mb-2">
            <div class="col">
                <label class="form-label">City</label>
                <input type="text" asp-for="City" class="form-control" />
            </div>
            <div class="col">
                <label class="form-label">State</label>
                <input type="text" asp-for="State" class="form-control" />
            </div>
        </div>

        <div class="row mb-2">
            <div class="col">
                <label class="form-label">Country</label>
                <input type="text" asp-for="Country" class="form-control" />
            </div>
            <div class="col">
                <label class="form-label">Postal Code</label>
                <input type="text" asp-for="PostalCode" class="form-control" />
            </div>
        </div>

        <div class="row mb-2">
            <div class="col">
                <label class="form-label">Tax Number</label>
                <input type="text" asp-for="TaxNumber" class="form-control" />
            </div>
            <div class="col">
                <label class="form-label">Payment Terms (days)</label>
                <input type="number" asp-for="PaymentTerms" class="form-control" min="0" />
            </div>
        </div>

        <div class="mb-3 form-check">
            <input type="checkbox" asp-for="IsActive" class="form-check-input" />
            <label class="form-check-label" asp-for="IsActive">Active</label>
        </div>

        <div class="mb-2">
            <button type="submit" class="btn btn-primary">Save</button>
        </div>
     </form>
</div>
