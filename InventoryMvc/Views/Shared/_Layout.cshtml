@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="/css/site.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
</head>
<body>
    <div id="sidebar">
        <div class="sidebar-brand">
            <div class="brand-icon"><i class="bi bi-box-seam"></i></div>
            <span class="brand-text">InventoryMgt</span>
            <button class="toggle-btn" onclick="toggleSidebar()" title="Toggle sidebar">
                <i class="bi bi-chevron-left"></i>
            </button>
        </div>

        <div class="sidebar-nav">
            <div class="nav-section-label">Main</div>

            <a class="nav-item-link active" href="/Dashboard/Index" onclick="setActive(this)">
                <i class="bi bi-grid-1x2-fill"></i>
                <span class="link-text">Dashboard</span>
            </a>
            <a class="nav-item-link" href="/Category/Index" onclick="setActive(this)">
                <i class="bi bi-tag-fill"></i>
                <span class="link-text">Categories</span>
            </a>
            <a class="nav-item-link" href="/Product/Index" onclick="setActive(this)">
                <i class="bi bi-box-fill"></i>
                <span class="link-text">Products</span>
            </a>
            <a class="nav-item-link" href="/Supplier/Index" onclick="setActive(this)">
                <i class="bi bi-truck"></i>
                <span class="link-text">Suppliers</span>
            </a>

            <div class="nav-section-label">Operations</div>

            <a class="nav-item-link" onclick="setActive(this)">
                <i class="bi bi-archive-fill"></i>
                <span class="link-text">Stock</span>
            </a>
            @*<a class="nav-item-link" onclick="setActive(this)">
                <i class="bi bi-arrow-left-right"></i>
                <span class="link-text">Transfers</span>
            </a>
             <a class="nav-item-link" onclick="setActive(this)">
                <i class="bi bi-receipt"></i>
                <span class="link-text">Orders</span>
            </a>
            <a class="nav-item-link" onclick="setActive(this)">
                <i class="bi bi-bar-chart-fill"></i>
                <span class="link-text">Reports</span>
            </a> *@
        </div>

        <div class="sidebar-footer">
            <form asp-area="Identity"
                  asp-page="/Account/Logout"
                  asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })"
                  method="post">

                <button type="submit" class="logout-btn border-0 bg-transparent w-100 text-start">
                    <i class="bi bi-box-arrow-right"></i>
                    <span class="link-text">Logout</span>
                </button>
            </form>
            <a href="#" class="github-link"><i class="bi bi-github"></i></a>
        </div>
    </div>

    <!-- Main Content -->
    <div id="main-content">
        <!-- Topbar -->
        <div class="topbar">
            <span class="topbar-title">@ViewData["Title"]</span>
            <div class="topbar-right">
                @if (SignInManager.IsSignedIn(User))
{
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-person"></i>
                    <a style="font-size:14px; color:#495057; font-weight:500;" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">@User.Identity?.Name</a>
                </div>
}
            </div>
    
        </div>

        <!-- Page Content -->
        <div class="page-content">
            <partial name="_Notifications"/>
            @RenderBody()
        </div>

        <div class="page-footer">
            © 2026 InventoryMgt. All rights reserved.
        </div>
    </div>
   
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
            function toggleSidebar() {
            document.getElementById('sidebar').classList.toggle('collapsed');
            document.getElementById('main-content').classList.toggle('expanded');
            }

            function setActive(el) {
            document.querySelectorAll('.nav-item-link').forEach(a => a.classList.remove('active'));
            el.classList.add('active');
            }
    </script>


    @RenderSection("Scripts", required: false)
</body>
</html>
