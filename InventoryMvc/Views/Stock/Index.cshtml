@model InventoryMvc.ViewModels.StockDisplayViewModel
@{
    ViewData["Title"] = "Stock";
}
<div style="width:70%">
    <h2>Stock</h2>
    @* <a href="/Stock/AddProduct" class="btn btn-info mb-2">Add more</a> *@

    @if (Model != null && Model.Stocks.Count() > 0)
    {
        <form method="get" class="d-flex gap-2 mb-2">
            <input type="text" name="sTerm" placeholder="Search with product name" class="form-control" />

            <button class="btn btn-info" type="submit">Search</button>
            <a class="btn btn-info" href="/Stock/Index">Clear</a>
        </form>

        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Stock Name</th>
                    <th>Quantity</th>
                    @* <th>Action</th> *@
                </tr>
            </thead>

            <tbody>
                @foreach (var product in Model.Stocks)
                {
                    <tr>
                        <td>@product.ProductName</td>
                        <td>@product.Quantity</td>
                        @* <td>
                            <a class="btn btn-success" href="/Stock/UpdateProduct?id=@product.Id">Edit</a>
                            <a class="btn btn-danger" onclick="return window.confirm('Are you sure to delete it?')" href="/Stock/DeleteProduct?id=@product.Id">Delete</a>
                        </td> *@
                    </tr>
                }
            </tbody>
        </table>

        @* pagination *@
        <nav aria-label="...">
            <ul class="pagination">
                <li class='page-item @(Model.Page == 1 ? "disabled" : "")'>
                    <a class="page-link" tabindex="-1" href="/Stock/Index?sTerm=@Model.STerm&page=@(Model.Page - 1)&limit=@Model.Limit">Previous</a>
                </li>
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class='page-item @(Model.Page == i ? "active" : "")'><a class="page-link" href="/Stock/Index?sTerm=@Model.STerm&page=@i&limit=@Model.Limit">@i</a></li>
                }
                <li class='page-item @(Model.Page == Model.TotalPages ? "disabled" : "")'>
                    <a class="page-link" href="/Stock/Index?sTerm=@Model.STerm&page=@(Model.Page + 1)&limit=@Model.Limit">Next</a>
                </li>
            </ul>
        </nav>

    }
    else
    {
        <h3>No record(s) found</h3>
    }
</div>